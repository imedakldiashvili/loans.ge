# DOMAIN = test.loans.ge → test.loans.ge (customers), admin., partner., otp. (one-time codes, test only, behind a password).
# Certificates come from Let's Encrypt automatically (the DNS records must point at this server).
{
	email {$ACME_EMAIL}
}

(app) {
	encode gzip
	handle {
		root * /srv/{args[0]}
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN} {
	@api path /client/* /public/* /fs/* /docs /docs/*
	reverse_proxy @api api:4000
	import app client
}

admin.{$DOMAIN} {
	@api path /admin/* /public/* /fs/*
	reverse_proxy @api api:4000
	import app admin
}

partner.{$DOMAIN} {
	@api path /partner/* /public/* /fs/*
	reverse_proxy @api api:4000
	import app partner
}

otp.{$DOMAIN} {
	basic_auth {
		{$OTP_USER} {$OTP_PASSWORD_HASH}
	}
	@api path /dev/*
	reverse_proxy @api api:4000
	import app otp
}
