# Copy to deploy/.env on the server and fill in (deploy/.env is never committed).
DOMAIN=test.loans.ge
ACME_EMAIL=admin@loans.ge
# test environment: not "production" (keeps the OTP viewer working); a real server: production + DEV_OUTBOX=false
APP_ENV=staging
DEV_OUTBOX=true
DB_PASSWORD=change-me
# OTP viewer login (otp.DOMAIN): the hash from `docker run --rm caddy:2.8 caddy hash-password --plaintext '<password>'`
OTP_USER=loans
# keep the single quotes (the hash has $ signs)
OTP_PASSWORD_HASH=''
# web push keys (optional on a test server — generated on start when empty)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
