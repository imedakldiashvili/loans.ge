{
  "name": "loans-ge",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @loans/shared && npm run build -w @loans/api",
    "test": "npm run test -w @loans/shared",
    "dev:api": "npm run dev -w @loans/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:api": "npm run build && npm run test:api -w @loans/api",
    "dev:admin": "npm run dev -w @loans/admin",
    "dev:otp": "npm run dev -w @loans/otp-viewer",
    "dev:partner": "npm run dev -w @loans/partner",
    "dev:client": "npm run dev -w @loans/client"
  },
  "engines": {
    "node": ">=20"
  }
}
