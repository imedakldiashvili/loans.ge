# DOMAIN = test.loans.ge → test.loans.ge (customers), admin., partner., otp. (one-time codes — test servers only; the API drops /dev/* when APP_ENV=production).
# Certificates come from Let's Encrypt automatically (the DNS records must point at this server).
{
	email {$ACME_EMAIL}
}

(app) {
	encode gzip
	handle {
		root * /srv/{args[0]}
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN} {
	@api path /client/* /public/* /fs/* /docs /docs/*
	handle @api {
		reverse_proxy api:4000
	}
	import app client
}

admin.{$DOMAIN} {
	@api path /admin/* /public/* /fs/*
	handle @api {
		reverse_proxy api:4000
	}
	import app admin
}

partner.{$DOMAIN} {
	@api path /partner/* /public/* /fs/*
	handle @api {
		reverse_proxy api:4000
	}
	import app partner
}

otp.{$DOMAIN} {
	@api path /dev/*
	handle @api {
		reverse_proxy api:4000
	}
	import app otp
}
