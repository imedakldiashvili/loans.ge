# API
PORT=4000
DATABASE_URL=postgresql://loans:loans@localhost:5433/loans
REDIS_URL=redis://localhost:6379
# SMS / Email providers: console = write to the API log (no real sending yet)
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# File storage: local folder for now
STORAGE_DIR=./storage

# TEST ENVIRONMENTS ONLY: keep a copy of every one-time code for the OTP viewer (apps/otp-viewer).
# Ignored when NODE_ENV=production. Never enable on a real server.
DEV_OUTBOX=false
