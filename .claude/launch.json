        "-w",
        "@loans/admin"
      ],
      "port": 5173
    },
    {
      "name": "otp-viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@loans/otp-viewer"
      ],
      "port": 5174
    },
    {
      "name": "partner",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@loans/partner"
      ],
      "port": 5175
    },
    {
      "name": "prototypes",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
